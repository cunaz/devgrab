{
  "name": "devgrab",
  "version": "0.1.2",
  "description": "Firefox extension: download the scripts, stylesheets, source maps and other developer-relevant files of the current page as a ZIP archive.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e/run.mjs",
    "lint": "npx --yes web-ext@10.8.0 lint",
    "build": "node scripts/build.mjs",
    "start": "npx --yes web-ext@10.8.0 run"
  },
  "webExt": {
    "sourceDir": ".",
    "ignoreFiles": [
      "test",
      "scripts",
      "dist",
      "node_modules",
      "package.json",
      "README.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      ".editorconfig",
      ".gitignore",
      ".github"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cunaz/devgrab.git"
  },
  "bugs": {
    "url": "https://github.com/cunaz/devgrab/issues"
  },
  "homepage": "https://github.com/cunaz/devgrab#readme"
}
